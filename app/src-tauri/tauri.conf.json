{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SelfGlance",
  "version": "0.1.0",
  "identifier": "com.selfglance.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "SelfGlance",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "dashboard",
        "title": "SelfGlance",
        "url": "index.html?view=dashboard",
        "width": 980,
        "height": 720,
        "minWidth": 380,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bashanta Tiwari",
    "copyright": "Copyright 2026 Bashanta Tiwari",
    "category": "Productivity",
    "shortDescription": "Bond, a desktop guide that shows you the next click.",
    "longDescription": "SelfGlance is a Windows desktop guide. Bond reads the window in front of you, points at the next thing to click, and helps with what the job leaves behind. Everything runs on your laptop: no account, no cloud.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
